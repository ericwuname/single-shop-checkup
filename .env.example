# 复制为 .env 后按需修改。M1 全部有默认值，可以完全不建 .env 直接跑。

# ---------- 存储 ----------
# 留空 = 使用 <项目根>/data/checkup.db
DATABASE_URL=

# ---------- 访问控制（M7 WP-1，docs/08 §4） ----------
# 公网模式：1 = 通过隧道/公网暴露服务。**默认留空（关）**。
# ⚠️ 铁律（docs/08 §0）：WP-1 访问控制没验收通过之前，任何服务不许暴露公网。
PUBLIC_MODE=
# 访问码：公网模式下必须设置且 ≥ 20 位，否则服务拒绝启动。
# 生成命令（复制运行，只把结果贴在这里，绝不提交进仓库）：
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
APP_ACCESS_KEY=
# 公网模式下的 CORS 白名单（逗号分隔的来源）。留空 = 不放行任何跨域（同源使用，最安全）。
# 例：https://checkup.example.top
ALLOWED_ORIGINS=

# ---------- LLM 抽象层（施工单 2.3） ----------
# M1 只留接口，不接真模型：LLM_ENABLED=0 时所有调用直接抛 LLMNotConfiguredError。
LLM_ENABLED=0
LLM_PROVIDER=zhipu
# 开发模型：GLM-4.6（施工单 2.1）
LLM_MODEL=glm-4.6
# 产品内嵌视觉模型：GLM-4V（施工单 2.2，M3 才启用）
LLM_VISION_MODEL=glm-4v
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30

# ---------- 启动行为 ----------
# 1 = 启动时把 seed_metrics / dim_calendar 灌库（幂等）
SEED_ON_STARTUP=1
